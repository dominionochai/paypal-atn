{
  "name": "@paypal-atn/atn",
  "version": "0.0.0",
  "description": "PayPal Autonomous Trust Network - infrastructure layer for verifiable agent transactions",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/http/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "stream:server": "tsx --env-file-if-exists=.env src/streaming/server.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/payments/reconcile-cli.ts",
    "serve": "tsx --env-file-if-exists=.env src/http/server.ts",
    "paypal:smoke": "tsx --env-file-if-exists=.env scripts/paypal-smoke.mjs",
    "scenario": "tsx --env-file-if-exists=.env src/agents/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
